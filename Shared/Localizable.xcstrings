    "experience.check.timers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS steuert Hintergrundaufrufe und kann zeitgesteuerte Änderungen verzögern. Fehlt eine Timer-Überwachung, beende die Sitzung und starte sie erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS controls background callbacks and may delay timed changes. If a timer monitor is missing, end that session and start it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS controla las llamadas en segundo plano y puede retrasar los cambios temporizados. Si falta un monitor de temporizador, finaliza esa sesión y vuelve a iniciarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS contrôle les rappels en arrière-plan et peut retarder les changements programmés. Si le suivi d’un minuteur manque, terminez cette session puis relancez-la."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mengendalikan panggilan balik di latar belakang dan dapat menunda perubahan berbasis waktu. Jika pemantau timer tidak ada, akhiri sesi itu lalu mulai lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSがバックグラウンドの処理を管理するため、時刻に基づく切り替えが遅れる場合があります。タイマーの監視がない場合は、そのセッションを終了して再開してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS steruje wywołaniami w tle i może opóźniać zaplanowane zmiany. Jeśli brakuje monitora licznika, zakończ daną sesję i rozpocznij ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS controla as chamadas em segundo plano e pode atrasar as mudanças programadas. Se faltar um monitor de temporizador, encerre a sessão e inicie-a novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台回调由 iOS 调度，定时切换可能延迟。若限时监控缺失，请结束该会话后重新开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後台回調由 iOS 調度，定時切換可能延遲。若限時監控缺失，請結束該會話後重新開啟。"
          }
        }
      }
    },
