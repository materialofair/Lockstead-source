    "settings.faq.forgotpin" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgot your PIN? Revoke Lockstead's authorization in Settings > Screen Time to remove all restrictions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记 PIN?可在「设置 > 屏幕使用时间」中撤销 Lockstead 的授权，即可解除全部限制。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINを忘れた場合は、設定 → スクリーンタイムでLocksteadの認証を取り消すと、すべての制限を解除できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pamiętasz PIN-u? Cofnij autoryzację Lockstead w Ustawieniach > Czas przed ekranem, aby usunąć wszystkie ograniczenia."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘記 PIN?可在「設定 > 螢幕使用時間」中撤銷 Lockstead 的授權，即可解除全部限制。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN vergessen? Widerrufe die Lockstead-Berechtigung unter Einstellungen > Bildschirmzeit, um alle Einschränkungen aufzuheben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code PIN oublié ? Révoquez l’autorisation de Lockstead dans Réglages > Temps d’écran pour supprimer toutes les restrictions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has olvidado el PIN? Revoca la autorización de Lockstead en Ajustes > Tiempo de uso para eliminar todas las restricciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esqueceu o PIN? Revogue a autorização do Lockstead em Ajustes > Tempo de Uso para remover todas as restrições."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupa PIN? Cabut izin Lockstead di Pengaturan > Durasi Layar untuk menghapus semua pembatasan."
