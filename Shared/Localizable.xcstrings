    "paywall.autorenew.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically until canceled. Manage or cancel anytime in Settings > Apple Account > Subscriptions. The lifetime plan is a one-time purchase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅将自动续订，可随时在「设置 > Apple 账户 > 订阅」中管理或取消。终身版为一次性买断。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは解約するまで自動更新されます。「設定」>「Apple Account」>「サブスクリプション」でいつでも管理・解約できます。買い切りプランは1回限りのお支払いです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje odnawiają się automatycznie do momentu anulowania. Możesz nimi zarządzać lub anulować je w Ustawienia > Konto Apple > Subskrypcje. Plan dożywotni to jednorazowy zakup."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱將自動續訂，可隨時在「設定 > Apple 賬戶 > 訂閱」中管理或取消。終身版為一次性買斷。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements verlängern sich automatisch, bis sie gekündigt werden. Unter Einstellungen > Apple Account > Abonnements kannst du sie jederzeit verwalten oder kündigen. Der lebenslange Tarif ist ein einmaliger Kauf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement jusqu’à leur résiliation. Gérez-les ou résiliez-les à tout moment dans Réglages > Compte Apple > Abonnements. L’offre à vie est un achat unique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente hasta que se cancelan. Puedes gestionarlas o cancelarlas en Ajustes > Cuenta de Apple > Suscripciones. El plan de por vida es una compra única."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são renovadas automaticamente até serem canceladas. Gerencie ou cancele a qualquer momento em Ajustes > Conta Apple > Assinaturas. O plano vitalício é uma compra única."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diperpanjang otomatis hingga dibatalkan. Kelola atau batalkan kapan saja di Pengaturan > Akun Apple > Langganan. Paket seumur hidup adalah pembelian satu kali."
          }
        }
      }
    },
    "paywall.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Core protection stays free. VIP adds multi-app management, advanced rules, Guest Mode, and personalization."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基础守护永久免费。VIP 提供多 App 管理、高级规则、访客保护与个性化。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本的な保護は無料です。VIPでは複数アプリの管理、高度なルール、ゲストモード、カスタマイズを利用できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawowa ochrona pozostaje bezpłatna. VIP dodaje zarządzanie wieloma aplikacjami, zaawansowane reguły, tryb gościa i personalizację."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基礎守護永久免費。VIP 提供多 App 管理、高級規則、訪客保護與個性化。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Basisschutz bleibt kostenlos. VIP bietet Verwaltung mehrerer Apps, erweiterte Regeln, Gastmodus und Personalisierung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protection de base reste gratuite. VIP ajoute la gestion de plusieurs apps, des règles avancées, le mode invité et la personnalisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protección básica sigue siendo gratuita. VIP añade gestión de varias apps, reglas avanzadas, modo invitado y personalización."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A proteção básica continua gratuita. O VIP adiciona gerenciamento de vários apps, regras avançadas, modo convidado e personalização."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlindungan dasar tetap gratis. VIP menambahkan pengelolaan banyak app, aturan lanjutan, mode tamu, dan personalisasi."
          }
        }
      }
