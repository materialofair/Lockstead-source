    "auth.failure.reasons" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häufige Ursachen: Du bist nicht mit einer Apple-ID angemeldet oder „Bildschirmzeit“ ist in den Einstellungen nicht aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common causes: not signed in with an Apple ID, or Screen Time isn't enabled in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Causas habituales: no has iniciado sesión con un ID de Apple o Tiempo de uso no está activado en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Causes fréquentes : vous n’êtes pas connecté à un identifiant Apple, ou Temps d’écran n’est pas activé dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyebab umum: belum masuk dengan ID Apple, atau Durasi Layar belum diaktifkan di Pengaturan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主な原因：Apple IDにサインインしていない、または設定でスクリーンタイムが有効になっていない。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typowe przyczyny: brak logowania do Apple ID lub wyłączony Czas przed ekranem w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Causas comuns: você não iniciou sessão com um ID Apple ou o Tempo de Uso não está ativado nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常见原因:未登录 Apple ID，或未在系统设置中开启屏幕使用时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常見原因:未登入 Apple ID，或未在系統設定中開啟螢幕使用時間。"
          }
        }
      }
    },
