    "intent.locknow.desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert die App-Sperre und beendet jede temporäre Entsperrung. Kurzbefehle verstärken nur den Schutz — zum Entsperren ist immer deine PIN in Lockstead erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns on app locking and ends any temporary unlock. Shortcuts only strengthen protection — unlocking always requires your PIN in Lockstead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el bloqueo de apps y finaliza cualquier desbloqueo temporal. Los atajos solo refuerzan la protección; desbloquear siempre requiere tu PIN en Lockstead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active le verrouillage des apps et met fin au déverrouillage temporaire. Les raccourcis renforcent uniquement la protection ; le déverrouillage exige toujours votre code PIN dans Lockstead."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaktifkan penguncian app dan mengakhiri pembukaan kunci sementara. Pintasan hanya memperkuat perlindungan; membuka kunci selalu memerlukan PIN di Lockstead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのロックをオンにし、一時ロック解除を終了します。ショートカットは保護の強化のみ行います。ロック解除には必ずLocksteadでPINを入力してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza blokadę aplikacji i kończy tymczasowe odblokowanie. Skróty służą tylko do wzmacniania ochrony — odblokowanie zawsze wymaga PIN-u w Lockstead."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa o bloqueio de apps e encerra qualquer desbloqueio temporário. Os atalhos apenas reforçam a proteção; desbloquear sempre exige seu PIN no Lockstead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启锁定并终止生效中的临时解锁。快捷指令只提供加强守护的动作,解除始终需要在 Lockstead 中输入 PIN。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟鎖定並終止生效中的臨時解鎖。快捷指令只提供加強守護的動作,解除始終需要在 Lockstead 中輸入 PIN。"
          }
        }
      }
    },
