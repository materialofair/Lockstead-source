    "settings.calculatorlogin.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launch as a calculator. Enter your 6-digit PIN and tap = to unlock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时显示计算器；输入 6 位 PIN 后按 = 解锁。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電卓として起動します。6桁のPINを入力し、「=」をタップしてロックを解除します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamiaj jako kalkulator. Wpisz sześciocyfrowy PIN i dotknij =, aby odblokować."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啓動時顯示計算機；輸入 6 位 PIN 後按 = 解鎖。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet als Rechner. Gib deine 6-stellige PIN ein und tippe zum Entsperren auf =."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ouvre comme une calculatrice. Saisissez votre code PIN à 6 chiffres et touchez = pour déverrouiller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abre como calculadora. Introduce tu PIN de 6 dígitos y toca = para desbloquear."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre como calculadora. Digite seu PIN de 6 dígitos e toque em = para desbloquear."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuka sebagai kalkulator. Masukkan PIN 6 digit dan ketuk = untuk membuka kunci."
          }
        }
      }
    },
