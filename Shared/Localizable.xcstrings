    "experience.check.help.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Screen Time authorization in Settings. If an app was reinstalled or an iOS update changed its selection, select it again in Lockstead. Before uninstalling, use Clear All Restrictions in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置检查屏幕使用时间授权。若 App 重装或 iOS 更新后选择失效，请在 Lockstead 重新选择。卸载前请先在设置中解除全部限制。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でスクリーンタイムの認証を確認してください。アプリの再インストールやiOSの更新で選択が変わった場合は、Locksteadで選び直してください。アンインストール前には設定の「すべての制限を解除」を実行してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź autoryzację Czasu przed ekranem w Ustawieniach. Jeśli ponowna instalacja aplikacji lub aktualizacja iOS zmieniła wybór, wybierz ją ponownie w Lockstead. Przed odinstalowaniem usuń wszystkie ograniczenia w ustawieniach aplikacji."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在系統設定檢查螢幕使用時間授權。若 App 重裝或 iOS 更新後選擇失效，請在 Lockstead 重新選擇。解除安裝前請先在設定中解除全部限制。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Bildschirmzeit-Berechtigung in den Einstellungen. Wurde eine App neu installiert oder hat ein iOS-Update ihre Auswahl geändert, wähle sie in Lockstead erneut aus. Nutze vor dem Deinstallieren „Alle Einschränkungen aufheben“ in den Einstellungen von Lockstead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez l’autorisation Temps d’écran dans Réglages. Si une app a été réinstallée ou si une mise à jour d’iOS a modifié sa sélection, sélectionnez-la à nouveau dans Lockstead. Avant de désinstaller, utilisez « Supprimer toutes les restrictions » dans les réglages de Lockstead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la autorización de Tiempo de uso en Ajustes. Si se ha reinstalado una app o una actualización de iOS ha cambiado su selección, vuelve a seleccionarla en Lockstead. Antes de desinstalar, usa Eliminar todas las restricciones en los ajustes de Lockstead."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique a autorização do Tempo de Uso nos Ajustes. Se um app foi reinstalado ou uma atualização do iOS alterou sua seleção, selecione-o novamente no Lockstead. Antes de desinstalar, use Remover todas as restrições nas configurações do Lockstead."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa izin Durasi Layar di Pengaturan. Jika app dipasang ulang atau pembaruan iOS mengubah pilihannya, pilih lagi di Lockstead. Sebelum menghapus Lockstead, gunakan Hapus semua pembatasan di pengaturan Lockstead."
          }
        }
      }
    },
