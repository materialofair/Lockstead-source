    "home.lock.note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sperre nutzt Apples Managed Settings, um den Start ausgewählter Apps zu verhindern. Sie bleibt aktiv, bis du sie in Lockstead deaktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock uses Apple's Managed Settings to prevent selected apps from launching. It stays active until you turn it off in Lockstead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo usa Managed Settings de Apple para impedir que se abran las apps seleccionadas. Permanece activo hasta que lo desactives en Lockstead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage utilise Managed Settings d’Apple pour empêcher le lancement des apps sélectionnées. Il reste actif jusqu’à sa désactivation dans Lockstead."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci menggunakan Managed Settings dari Apple untuk mencegah app terpilih dibuka. Kunci tetap aktif hingga dinonaktifkan di Lockstead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックにはAppleのManaged Settingsを使用し、選択したアプリの起動を防ぎます。Locksteadで無効にするまで有効です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokada korzysta z Managed Settings firmy Apple, aby uniemożliwić uruchamianie wybranych aplikacji. Działa, dopóki nie wyłączysz jej w Lockstead."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bloqueio usa o Managed Settings da Apple para impedir a abertura dos apps selecionados. Ele permanece ativo até você desativá-lo no Lockstead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定使用 Apple 的管理设置来阻止所选 App 启动,并持续生效,直到你在 Lockstead 中关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定使用 Apple 的管理設定來阻止所選 App 啓動,並持續生效,直到你在 Lockstead 中關閉。"
          }
        }
      }
    },
