    "intent.guest.desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only your guest allowlist stays usable; all other apps are blocked. Everything restores automatically when time is up. Requires VIP and a configured guest allowlist."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只放行访客白名单,其余 App 全部被阻止;到时自动恢复。需要 VIP 并已配置访客白名单。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストの許可リストにあるアプリのみ利用でき、それ以外はブロックされます。時間が終了すると自動で復元します。VIPとゲストの許可リストの設定が必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępne pozostają tylko aplikacje z listy dozwolonych dla gościa; pozostałe są zablokowane. Po upływie czasu wszystko przywraca się automatycznie. Wymagane są VIP i skonfigurowana lista gościa."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只放行訪客白名單,其餘 App 全部被阻止;到時自動恢復。需要 VIP 並已配置訪客白名單。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Apps auf deiner Gast-Freigabeliste bleiben nutzbar; alle anderen werden gesperrt. Nach Ablauf der Zeit wird alles automatisch wiederhergestellt. Erfordert VIP und eine eingerichtete Gast-Freigabeliste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les apps de votre liste autorisée pour l’invité restent utilisables ; toutes les autres sont bloquées. Tout est rétabli automatiquement à la fin du délai. Nécessite VIP et une liste d’apps autorisées pour l’invité configurée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo seguirán disponibles las apps de tu lista de apps permitidas para invitados; las demás se bloquearán. Todo se restaura automáticamente cuando termine el tiempo. Requiere VIP y una lista de apps permitidas para invitados configurada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente os apps da sua lista de apps permitidos para convidados continuam disponíveis; todos os outros são bloqueados. Tudo é restaurado automaticamente quando o tempo termina. Requer VIP e uma lista de apps permitidos para convidados configurada."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya app dalam daftar yang diizinkan untuk tamu yang tetap dapat digunakan; semua app lain diblokir. Semua dipulihkan otomatis saat waktu habis. Memerlukan VIP dan daftar app yang diizinkan untuk tamu yang sudah diatur."
          }
        }
      }
    },
