    "experience.scenes.confirm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ersetzt deine aktuelle App-Liste und Regeln, beendet den temporären Zugriff und hebt „Heute aussetzen“ auf. Eine aktive Gastsitzung bleibt bis zu ihrem Ende geschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This replaces your current app list and rules, ends temporary access and clears Skip Today. An active guest session stays protected until it ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplaza tu lista de apps y reglas actuales, finaliza el acceso temporal y desactiva Omitir hoy. Una sesión de invitado activa sigue protegida hasta que termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre liste d’apps et vos règles actuelles seront remplacées, l’accès temporaire prendra fin et « Ignorer aujourd’hui » sera annulé. Une session invitée active reste protégée jusqu’à sa fin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini mengganti daftar app dan aturan saat ini, mengakhiri akses sementara, dan membatalkan Lewati hari ini. Sesi tamu yang aktif tetap dilindungi hingga berakhir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアプリ一覧とルールを置き換え、一時アクセスを終了し、「今日をスキップ」を解除します。有効なゲストセッションの保護は、その終了まで続きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastąpi to bieżącą listę aplikacji i reguły, zakończy tymczasowy dostęp i wyłączy opcję „Pomiń dzisiaj”. Aktywna sesja gościa pozostanie chroniona do końca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso substitui sua lista de apps e regras atuais, encerra o acesso temporário e desativa Ignorar hoje. Uma sessão de convidado ativa permanece protegida até terminar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会替换当前 App 清单与规则，结束临时放行并清除“跳过今天”。正在进行的访客模式会继续保护设备，直到结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會替換當前 App 清單與規則，結束臨時放行並清除“跳過今天”。正在進行的訪客模式會繼續保護裝置，直到結束。"
          }
        }
      }
    },
