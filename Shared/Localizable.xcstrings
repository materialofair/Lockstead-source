    "experience.scenes.failed" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scene could not be fully applied. Check your configuration and schedule registration in Protection Check."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "场景未能完整应用。请在守护检查中查看配置与时间表注册状态。"
          }
        },
        "ja" : {
          "stringUnit" : {
