    "home.guest.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before handing your phone over: only the apps above stay usable and everything else is blocked. Restores automatically when time is up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手机递出去前开启:仅上方 App 可用,其余 App 全部被阻止。时间到自动恢复。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンを渡す前に：上記のアプリのみ使用可能になり、ほかはすべてブロックされます。時間が終了すると自動的に元に戻ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed przekazaniem telefonu: dostępne pozostaną tylko aplikacje powyżej, a wszystkie inne zostaną zablokowane. Po upływie czasu ustawienia zostaną automatycznie przywrócone."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手機遞出去前開啟:僅上方 App 可用,其餘 App 全部被阻止。時間到自動恢復。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor du dein Handy weitergibst: Nur die Apps oben bleiben nutzbar, alles andere wird gesperrt. Nach Ablauf der Zeit wird der vorherige Zustand automatisch wiederhergestellt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de prêter votre téléphone : seules les apps ci-dessus restent utilisables, toutes les autres sont bloquées. Le rétablissement est automatique à la fin du délai."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de entregar el teléfono: solo las apps anteriores seguirán disponibles y todo lo demás se bloqueará. Se restaura automáticamente cuando termine el tiempo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de entregar seu celular: apenas os apps acima continuam disponíveis e todo o restante é bloqueado. A restauração ocorre automaticamente quando o tempo termina."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum menyerahkan ponsel: hanya app di atas yang tetap dapat digunakan dan semua yang lain diblokir. Dipulihkan otomatis saat waktu habis."
          }
        }
      }
    },
