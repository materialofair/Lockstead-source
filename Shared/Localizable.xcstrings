    "pin.setup.recovery.note" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN vergessen? Du kannst die Bildschirmzeit-Berechtigung von Lockstead in den Einstellungen widerrufen, um alle Einschränkungen aufzuheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgot your PIN? You can revoke Lockstead's Screen Time authorization in Settings to remove all restrictions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has olvidado el PIN? Puedes revocar la autorización de Tiempo de uso de Lockstead en Ajustes para eliminar todas las restricciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code PIN oublié ? Vous pouvez révoquer l’autorisation Temps d’écran de Lockstead dans Réglages pour supprimer toutes les restrictions."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupa PIN? Cabut izin Durasi Layar Lockstead di Pengaturan untuk menghapus semua pembatasan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINを忘れた場合は、設定のスクリーンタイムでLocksteadの認証を取り消すと、すべての制限を解除できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pamiętasz PIN-u? Możesz cofnąć autoryzację Lockstead w ustawieniach Czasu przed ekranem, aby usunąć wszystkie ograniczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esqueceu o PIN? Você pode revogar a autorização do Tempo de Uso do Lockstead nos Ajustes para remover todas as restrições."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记 PIN?可在「设置 > 屏幕使用时间」中撤销 Lockstead 的授权，以解除全部限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘記 PIN?可在「設定 > 螢幕使用時間」中撤銷 Lockstead 的授權，以解除全部限制。"
          }
        }
      }
    },
