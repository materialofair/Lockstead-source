          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawowa ochrona pozostaje bezpłatna. VIP dodaje zarządzanie wieloma aplikacjami, zaawansowane reguły, tryb gościa i personalizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
