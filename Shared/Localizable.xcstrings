    "experience.check.honest" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This page checks your configuration and registered monitors. Only opening a protected app can confirm that iOS is actually blocking it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里检查配置与已注册的监控。是否实际拦截，需要打开受保护 App 验证。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このページでは設定と登録済みの監視を確認します。iOSが実際にブロックしているかどうかは、保護対象のアプリを開いて確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta strona sprawdza konfigurację i zarejestrowane monitory. Tylko otwarcie chronionej aplikacji pozwala potwierdzić, że iOS faktycznie ją blokuje."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡檢查配置與已註冊的監控。是否實際攔截，需要打開受保護 App 驗證。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Seite prüft deine Konfiguration und registrierte Überwachungen. Nur durch Öffnen einer geschützten App lässt sich bestätigen, dass iOS sie tatsächlich sperrt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette page vérifie votre configuration et les suivis enregistrés. Seule l’ouverture d’une app protégée permet de confirmer qu’iOS la bloque réellement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta página comprueba la configuración y los monitores registrados. Solo al abrir una app protegida puedes confirmar que iOS la está bloqueando realmente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta página verifica sua configuração e os monitores registrados. Somente abrir um app protegido pode confirmar que o iOS está realmente bloqueando-o."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halaman ini memeriksa konfigurasi dan pemantau terdaftar. Hanya dengan membuka app yang dilindungi, Anda dapat memastikan bahwa iOS benar-benar memblokirnya."
          }
        }
      }
    },
