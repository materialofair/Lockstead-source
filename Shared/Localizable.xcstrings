          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível aplicar o cenário por completo. Verifique a configuração e o registro da programação em Verificação da proteção."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenario tidak dapat diterapkan sepenuhnya. Periksa konfigurasi dan pendaftaran jadwal di Pemeriksaan perlindungan."
          }
        }
      }
    },
    "experience.scenes.intro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your current app list, lock mode and schedule for learning, bedtime or lending your phone. Changes to a scene are saved as a new scene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将当前 App 清单、锁定模式和时间表保存为学习、睡前或借出场景。修改后的配置可另存为新场景。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアプリ一覧、ロックモード、スケジュールを、学習時、就寝時、スマートフォンを貸すときのシーンとして保存できます。変更した設定は新しいシーンとして保存します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz bieżącą listę aplikacji, tryb blokady i harmonogram na czas nauki, snu lub pożyczenia telefonu. Zmienioną konfigurację zapisuje się jako nową scenę."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將當前 App 清單、鎖定模式和時間表保存為學習、睡前或借出場景。修改後的配置可另存為新場景。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deine aktuelle App-Liste, den Sperrmodus und den Zeitplan zum Lernen, Schlafengehen oder Verleihen deines Handys. Änderungen an einer Szene werden als neue Szene gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre liste d’apps, votre mode de verrouillage et votre programme pour étudier, dormir ou prêter votre téléphone. Les modifications d’un scénario sont enregistrées dans un nouveau scénario."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu lista de apps, modo de bloqueo y horario actuales para estudiar, dormir o prestar el teléfono. Los cambios en un escenario se guardan como uno nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve sua lista de apps, modo de bloqueio e programação atuais para estudar, dormir ou emprestar o celular. As alterações em um cenário são salvas como um novo cenário."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan daftar app, mode kunci, dan jadwal saat ini untuk belajar, waktu tidur, atau meminjamkan ponsel. Perubahan pada skenario disimpan sebagai skenario baru."
          }
        }
      }
    },
