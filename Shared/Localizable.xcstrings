    "pin.setup.recovery.note" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgot your PIN? You can revoke Lockstead's Screen Time authorization in Settings to remove all restrictions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记 PIN?可在「设置 > 屏幕使用时间」中撤销 Lockstead 的授权，以解除全部限制。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
