    "settings.biometric.detail" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere dies nur, wenn das gespeicherte Gesicht oder der Fingerabdruck dir gehört — jede auf diesem Gerät registrierte Person kann entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable only if the enrolled face or fingerprint is yours — anyone enrolled on this device can unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo solo si el rostro o la huella registrados son tuyos; cualquier persona registrada en este dispositivo puede desbloquear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette option uniquement si le visage ou l’empreinte enregistrés sont les vôtres ; toute personne enregistrée sur cet appareil peut déverrouiller."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan hanya jika wajah atau sidik jari yang terdaftar adalah milik Anda — siapa pun yang terdaftar di perangkat ini dapat membuka kunci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録された顔や指紋が自分のものの場合のみ有効にしてください。このデバイスに登録された生体情報はすべてロック解除に使えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz tylko wtedy, gdy zarejestrowana twarz lub odcisk palca należy do Ciebie. Każda osoba z biometrią zarejestrowaną na tym urządzeniu może odblokować aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative apenas se o rosto ou a impressão digital cadastrados forem seus; qualquer pessoa cadastrada neste dispositivo pode desbloquear."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当设备录入的面容/指纹是你本人时开启——已录入者都能解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅當裝置錄入的面容/指紋是你本人時開啟——已錄入者都能解鎖。"
          }
        }
      }
    },
