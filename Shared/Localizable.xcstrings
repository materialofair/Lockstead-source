          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場景未能完整應用。請在守護檢查中查看配置與時間表註冊狀態。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Szene konnte nicht vollständig angewendet werden. Prüfe die Konfiguration und Zeitplanregistrierung unter „Schutzprüfung“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scénario n’a pas pu être entièrement appliqué. Vérifiez votre configuration et l’enregistrement du programme dans Vérification de la protection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
