    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock Lockstead with Face ID instead of entering your PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用面容 ID 解锁 Lockstead，无需输入 PIN。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINを入力する代わりに、Face IDでLocksteadをロック解除します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokuj Lockstead za pomocą Face ID zamiast wpisywania PIN-u."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用Face ID 解鎖 Lockstead，無需輸入 PIN。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre Lockstead mit Face ID, statt deine PIN einzugeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez Lockstead avec Face ID plutôt qu’en saisissant votre code PIN."
