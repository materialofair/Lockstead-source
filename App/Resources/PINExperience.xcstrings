    "pin.manage.hint.note" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your hint is visible on the PIN login screen. Do not include your PIN. Clear this field to remove the hint."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示会显示在 PIN 登录页，请不要填写 PIN 本身。清空此项即可删除提示。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒントはPINログイン画面に表示されます。PINそのものは記入しないでください。空欄にするとヒントを削除できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówka jest widoczna na ekranie logowania PIN-em. Nie wpisuj w niej PIN-u. Wyczyść pole, aby usunąć wskazówkę."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示會顯示在 PIN 登入頁，請不要填寫 PIN 本身。清空此項即可刪除提示。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hinweis ist auf dem PIN-Anmeldebildschirm sichtbar. Er darf deine PIN nicht enthalten. Leere dieses Feld, um den Hinweis zu entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre indice est visible sur l’écran de connexion par code PIN. N’y indiquez pas votre code PIN. Videz ce champ pour supprimer l’indice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pista es visible en la pantalla de acceso con PIN. No incluyas tu PIN. Vacía este campo para eliminar la pista."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua dica fica visível na tela de login com PIN. Não inclua seu PIN. Limpe este campo para remover a dica."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petunjuk terlihat di layar masuk PIN. Jangan sertakan PIN Anda. Kosongkan kolom ini untuk menghapus petunjuk."
          }
        }
      }
    },
