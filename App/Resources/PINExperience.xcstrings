    "pin.recovery.persistence" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoking Screen Time access does not reset this PIN. The PIN is stored in this device’s Keychain and may remain after reinstalling. There is no forgotten-PIN reset in the app. Keep your PIN somewhere safe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤销屏幕使用时间权限不会重置 PIN。PIN 保存在本机钥匙串中，重新安装后也可能保留。App 不提供忘记 PIN 后的重置入口，请妥善保管 PIN。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンタイムへのアクセスを取り消しても、このPINはリセットされません。PINはこのデバイスのキーチェーンに保存され、再インストール後も残る場合があります。アプリには忘れたPINをリセットする機能はありません。PINを安全な場所に保管してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cofnięcie dostępu do Czasu przed ekranem nie resetuje tego PIN-u. PIN jest zapisany w pęku kluczy urządzenia i może pozostać po ponownej instalacji. Aplikacja nie umożliwia resetowania zapomnianego PIN-u. Przechowuj go w bezpiecznym miejscu."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤銷螢幕使用時間權限不會重置 PIN。PIN 保存在本機鑰匙圈中，重新安裝後也可能保留。App 不提供忘記 PIN 後的重置入口，請妥善保管 PIN。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Widerruf des Bildschirmzeit-Zugriffs setzt diese PIN nicht zurück. Die PIN wird im Schlüsselbund dieses Geräts gespeichert und kann nach einer Neuinstallation erhalten bleiben. Die App bietet keine Zurücksetzung für vergessene PINs. Bewahre deine PIN sicher auf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Révoquer l’accès à Temps d’écran ne réinitialise pas ce code PIN. Il est stocké dans le trousseau de cet appareil et peut subsister après une réinstallation. L’app ne propose pas de réinitialisation en cas d’oubli du code PIN. Conservez-le en lieu sûr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revocar el acceso a Tiempo de uso no restablece este PIN. El PIN se guarda en el llavero del dispositivo y puede conservarse tras reinstalar la app. La app no permite restablecer un PIN olvidado. Guárdalo en un lugar seguro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revogar o acesso ao Tempo de Uso não redefine este PIN. O PIN é armazenado nas Chaves deste dispositivo e pode permanecer após uma reinstalação. O app não oferece redefinição de PIN esquecido. Guarde seu PIN em um lugar seguro."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencabut akses Durasi Layar tidak mereset PIN ini. PIN disimpan di Keychain perangkat ini dan mungkin tetap ada setelah pemasangan ulang. App tidak menyediakan reset PIN yang terlupa. Simpan PIN Anda di tempat aman."
          }
        }
      }
    },
    "pin.recovery.remember" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try the hint on the PIN login screen. After repeated incorrect attempts, wait until the cooldown ends before trying again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请参考 PIN 登录页的提示。连续输错后，需要等待冷却结束才能再次尝试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PINログイン画面のヒントを確認してください。入力を繰り返し間違えた場合は、待機時間が終了してから再試行してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź wskazówkę na ekranie logowania PIN-em. Po wielokrotnych błędnych próbach zaczekaj na koniec okresu blokady przed kolejną próbą."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請參考 PIN 登入頁的提示。連續輸錯後，需要等待冷卻結束才能再次嘗試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den Hinweis auf dem PIN-Anmeldebildschirm. Warte nach wiederholten Fehlversuchen bis zum Ende der Sperrzeit, bevor du es erneut versuchst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez l’indice sur l’écran de connexion par code PIN. Après plusieurs tentatives incorrectes, attendez la fin du délai avant de réessayer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta la pista en la pantalla de acceso con PIN. Tras varios intentos incorrectos, espera a que termine el tiempo de espera antes de reintentarlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulte a dica na tela de login com PIN. Após várias tentativas incorretas, espere o fim do período de espera antes de tentar novamente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba petunjuk di layar masuk PIN. Setelah beberapa percobaan yang salah, tunggu hingga masa tunggu berakhir sebelum mencoba lagi."
          }
        }
      }
    },
    "pin.recovery.system" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To stop restrictions without entering the app, use iPhone Settings → Screen Time and revoke this app’s Screen Time access. The wording can vary by iOS version; device or family restrictions may require the owner’s Screen Time passcode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需在无法进入 App 时停止限制，可前往 iPhone「设置」→「屏幕使用时间」，撤销本 App 的屏幕使用时间访问权限。不同 iOS 版本的名称可能不同；设备或家庭限制可能要求所有者输入屏幕使用时间密码。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリに入れない状態で制限を解除するには、iPhoneの「設定」→「スクリーンタイム」で、このアプリのアクセスを取り消してください。項目名はiOSのバージョンにより異なります。デバイスやファミリーの制限によっては、所有者のスクリーンタイム・パスコードが必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby usunąć ograniczenia bez otwierania aplikacji, przejdź do Ustawienia iPhone’a → Czas przed ekranem i cofnij dostęp tej aplikacji. Nazwy opcji mogą różnić się między wersjami iOS; ograniczenia urządzenia lub rodziny mogą wymagać kodu Czasu przed ekranem właściciela."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如需在無法進入 App 時停止限制，可前往 iPhone「設定」→「螢幕使用時間」，撤銷本 App 的螢幕使用時間存取權限。不同 iOS 版本的名稱可能不同；裝置或家庭限制可能要求所有者輸入螢幕使用時間密碼。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Einschränkungen aufzuheben, ohne die App zu öffnen, gehe zu iPhone-Einstellungen → Bildschirmzeit und widerrufe den Bildschirmzeit-Zugriff dieser App. Die Bezeichnungen können je nach iOS-Version abweichen; Geräte- oder Familienbeschränkungen können den Bildschirmzeit-Code des Eigentümers erfordern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour arrêter les restrictions sans ouvrir l’app, allez dans Réglages de l’iPhone → Temps d’écran et révoquez l’accès de cette app à Temps d’écran. Les libellés peuvent varier selon la version d’iOS ; les restrictions de l’appareil ou de la famille peuvent exiger le code Temps d’écran du propriétaire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para detener las restricciones sin entrar en la app, ve a Ajustes del iPhone → Tiempo de uso y revoca el acceso de esta app a Tiempo de uso. El texto puede variar según la versión de iOS; las restricciones del dispositivo o de la familia pueden requerir el código de Tiempo de uso del propietario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para encerrar as restrições sem entrar no app, vá aos Ajustes do iPhone → Tempo de Uso e revogue o acesso deste app ao Tempo de Uso. Os nomes podem variar conforme a versão do iOS; restrições do dispositivo ou da família podem exigir o código do Tempo de Uso do proprietário."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menghentikan pembatasan tanpa masuk ke app, buka Pengaturan iPhone → Durasi Layar dan cabut akses Durasi Layar app ini. Istilah dapat berbeda menurut versi iOS; pembatasan perangkat atau keluarga mungkin memerlukan kode sandi Durasi Layar pemilik."
          }
        }
      }
    },
