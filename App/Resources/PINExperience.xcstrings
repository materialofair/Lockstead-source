    "pin.recovery.biometric" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If biometric unlock was enabled, you may still be able to enter the app from the PIN login screen. Changing the PIN or hint still requires the current PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已启用生物识别，可尝试从 PIN 登录页进入 App。修改 PIN 或提示仍需要当前 PIN。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生体認証を有効にしていた場合、PINログイン画面からアプリに入れる可能性があります。PINやヒントの変更には、現在のPINが必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli odblokowanie biometryczne było włączone, być może nadal możesz wejść do aplikacji z ekranu logowania PIN-em. Zmiana PIN-u lub wskazówki wymaga obecnego PIN-u."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果已啟用生物識別，可嘗試從 PIN 登入頁進入 App。修改 PIN 或提示仍需要當前 PIN。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn biometrisches Entsperren aktiviert war, kannst du die App möglicherweise noch über den PIN-Anmeldebildschirm öffnen. Zum Ändern der PIN oder des Hinweises ist weiterhin die aktuelle PIN erforderlich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le déverrouillage biométrique était activé, vous pouvez peut-être encore accéder à l’app depuis l’écran de connexion par code PIN. Modifier le code PIN ou l’indice exige toujours le code PIN actuel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el desbloqueo biométrico estaba activado, es posible que aún puedas acceder a la app desde la pantalla de acceso con PIN. Cambiar el PIN o la pista sigue requiriendo el PIN actual."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o desbloqueio biométrico estava ativado, talvez você ainda consiga entrar no app pela tela de login com PIN. Alterar o PIN ou a dica ainda exige o PIN atual."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika pembukaan kunci biometrik diaktifkan, Anda mungkin masih dapat masuk ke app dari layar masuk PIN. Mengubah PIN atau petunjuk tetap memerlukan PIN saat ini."
          }
        }
      }
    },
