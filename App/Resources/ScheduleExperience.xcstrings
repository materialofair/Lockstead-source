    "rules.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add up to 6 windows. Overlapping windows keep protection active until all have ended."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多设置 6 个时间段。重叠时间段会合并生效，直到全部结束。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大6個の時間帯を追加できます。重複する時間帯がある場合、すべてが終了するまで保護が続きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz dodać maksymalnie 6 przedziałów czasu. Jeśli się nakładają, ochrona działa do zakończenia wszystkich."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多設定 6 個時間段。重疊時間段會合併生效，直到全部結束。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge bis zu 6 Zeitfenster hinzu. Bei Überschneidungen bleibt der Schutz aktiv, bis alle Zeitfenster beendet sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez jusqu’à 6 plages horaires. En cas de chevauchement, la protection reste active jusqu’à la fin de toutes les plages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade hasta 6 periodos. Si se superponen, la protección sigue activa hasta que terminen todos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione até 6 períodos. Quando há sobreposição, a proteção permanece ativa até que todos terminem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan hingga 6 rentang waktu. Rentang yang tumpang tindih mempertahankan perlindungan hingga semuanya berakhir."
          }
        }
      }
    },
    "rules.save.failed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your configuration was saved, but automatic scheduling is unavailable. Try saving again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置已保存，但自动调度暂不可用。请再次保存以重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定は保存されましたが、自動スケジュールは利用できません。もう一度保存してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurację zapisano, ale automatyczny harmonogram jest niedostępny. Spróbuj zapisać ponownie."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置已保存，但自動調度暫不可用。請再次保存以重試。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Konfiguration wurde gespeichert, aber die automatische Planung ist nicht verfügbar. Versuche erneut zu speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre configuration a été enregistrée, mais le programme automatique est indisponible. Réessayez d’enregistrer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración se ha guardado, pero la programación automática no está disponible. Intenta guardar de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua configuração foi salva, mas a programação automática está indisponível. Tente salvar novamente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurasi disimpan, tetapi jadwal otomatis tidak tersedia. Coba simpan lagi."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
