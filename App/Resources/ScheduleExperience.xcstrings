    "rules.invalid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose at least one day and a window of 15 minutes or longer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少选择一天，且时间段不得短于 15 分钟。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曜日を1つ以上選び、15分以上の時間帯を設定してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz co najmniej jeden dzień i przedział czasu trwający przynajmniej 15 minut."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請至少選擇一天，且時間段不得短於 15 分鐘。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mindestens einen Tag und ein Zeitfenster von mindestens 15 Minuten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez au moins un jour et une plage d’au moins 15 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige al menos un día y un periodo de 15 minutos o más."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha pelo menos um dia e um período de 15 minutos ou mais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih minimal satu hari dan rentang waktu 15 menit atau lebih."
          }
        }
      }
    },
    "rules.overnight" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continues into the next morning. Selected weekdays refer to the start day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "延续到次日早晨；所选星期对应开始日期。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翌朝まで続きます。選択した曜日は開始日の曜日です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejmuje też następny poranek. Wybrane dni tygodnia odnoszą się do dnia rozpoczęcia."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "延續到次日早晨；所選星期對應開始日期。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft bis zum nächsten Morgen. Die ausgewählten Wochentage beziehen sich auf den Starttag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se prolonge jusqu’au lendemain matin. Les jours sélectionnés correspondent au jour de début."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa hasta la mañana siguiente. Los días seleccionados corresponden al día de inicio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua até a manhã seguinte. Os dias selecionados se referem ao dia de início."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlanjut hingga pagi berikutnya. Hari yang dipilih merujuk pada hari mulai."
          }
        }
      }
    },
    "rules.add" : {
